{
  "name": "@shogi-games/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "self-play:daemon": "nice -n 15 tsx src/scripts/selfPlayDaemon.ts",
    "tune:weights": "tsx src/scripts/tuneWeights.ts",
    "puzzles:generate": "tsx src/scripts/generatePuzzles.ts",
    "nnue:export-data": "tsx src/scripts/exportNnueTrainingData.ts",
    "nnue:export-teacher-data": "tsx src/scripts/exportNnueTeacherData.ts"
  },
  "dependencies": {
    "@shogi-games/db": "*",
    "@shogi-games/rule-engine": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
