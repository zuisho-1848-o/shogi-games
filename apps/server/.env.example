# DB接続先。packages/db/.envと同じ値を指定する(prisma clientの実行時はこちらのプロセスの環境変数が使われる)。
DATABASE_URL="mysql://root@localhost:3306/shogi_games_dev"

# サーバーのポート
PORT=4000

# フロント(Next.js)のオリジン。CORS許可 + socket.io許可オリジンに使う。
# 本番では実際のドメイン(例: https://shogi.highsto.net)に変更すること。
WEB_ORIGIN=http://localhost:3000

# JWT署名用シークレット。本番では必ずランダムな長い文字列に変更すること。
# 生成例: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Redis接続先(マッチング待機列・socket.io Redis adapterで使用)
REDIS_URL=redis://localhost:6379

# ランダムルールマッチングの条件緩和までの待機時間(ミリ秒)。省略時15000。
# MATCH_RELAX_TIMEOUT_MS=15000

# 自己対局デーモンの調整用(省略時は低負荷寄りの既定値を使う)
# SELF_PLAY_MOVE_DELAY_MS=400
# SELF_PLAY_GAME_DELAY_MS=8000
# SELF_PLAY_LOAD_THRESHOLD=0.7

# トラックB: 外部USIエンジン(やねうら王)を"ai_yaneuraou"プロファイルとして使う場合のみ設定。
# 未設定なら内蔵AIのみで動作する。ビルド方法はdocs/AI_ROADMAP.md参照。
# YANEURAOU_ENGINE_PATH=/path/to/YaneuraOu-by-gcc
# YANEURAOU_BYOYOMI_MS=3000
# ↑短すぎると評価関数強化(MATERIAL_LEVEL=9)の計算コストが探索の浅さとして跳ね返り、
# 逆に弱くなることが検証で分かっている(docs/AI_ROADMAP.md参照)。2〜3秒以上を推奨。
# YANEURAOU_EVAL_DIR=/path/to/eval (NNUE評価関数を使う場合。ライセンス確認必須)
